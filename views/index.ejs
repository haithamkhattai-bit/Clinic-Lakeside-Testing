<%- include("partials/header", { clinic }) %>

    <main>
      <section class="hero-section" id="home">
        <div class="container">
          <div class="row align-items-center g-5">
            <div class="col-lg-7">
              <span class="eyebrow"><i class="bi bi-geo-alt" aria-hidden="true"></i> Here for JLT</span>
              <h1><%= clinic.name %></h1>
              <p class="hero-tagline"><%= clinic.tagline %>.</p>
              <p class="hero-copy">From everyday check-ups to specialist care, our friendly team is here to help you and your family feel your best.</p>
              <a class="btn btn-primary btn-lg" href="/booking">
                Book an appointment <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
              </a>
              <div class="hero-note"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Compassionate care, all in one place</div>
            </div>
            <div class="col-lg-5">
              <div class="hero-art" role="img" aria-label="Illustration celebrating your health and wellbeing">
                <div class="art-orbit orbit-one"></div>
                <div class="art-orbit orbit-two"></div>
                <div class="art-card">
                  <div class="art-cross"><i class="bi bi-plus-lg" aria-hidden="true"></i></div>
                  <span>Care for every<br />chapter of life</span>
                  <i class="bi bi-heart-pulse art-heart" aria-hidden="true"></i>
                </div>
                <span class="art-dot dot-one"></span>
                <span class="art-dot dot-two"></span>
                <span class="art-dot dot-three"></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section specialties-section" id="specialties">
        <div class="container">
          <div class="section-heading text-center">
            <span class="eyebrow">Care for you</span>
            <h2>Our Specialties</h2>
            <p>Trusted expertise, with a personal touch.</p>
          </div>
          <div class="row g-4">
            <% specialties.forEach((specialty) => { %>
              <div class="col-sm-6 col-xl-3">
                <article class="specialty-card h-100">
                  <div class="specialty-icon"><i class="bi <%= specialty.icon %>" aria-hidden="true"></i></div>
                  <h3><%= specialty.name %></h3>
                  <p><%= specialty.description %></p>
                </article>
              </div>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="section about-section" id="about">
        <div class="container">
          <div class="row align-items-center g-5">
            <div class="col-lg-5">
              <div class="about-art" aria-hidden="true">
                <div class="about-circle"><i class="bi bi-person-hearts"></i></div>
                <div class="about-badge"><i class="bi bi-shield-check"></i><span>Care you can<br />count on</span></div>
              </div>
            </div>
            <div class="col-lg-6 offset-lg-1">
              <span class="eyebrow">A little closer to care</span>
              <h2>About Us</h2>
              <p class="about-lead">Good healthcare starts with listening.</p>
              <p>At <%= clinic.name %>, we bring experienced doctors and a welcoming team together under one roof. We take the time to understand what matters to you, explain your options, and make every visit feel a little easier.</p>
              <p>Whether you are visiting for a routine check-up or specialist advice, you can expect thoughtful, dependable care close to home.</p>
              <a class="text-link" href="/#contact">Come say hello <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
          </div>
        </div>
      </section>

      <section class="section contact-section" id="contact">
        <div class="container">
          <div class="contact-panel">
            <div class="row g-5">
              <div class="col-lg-5">
                <span class="eyebrow">We’re here to help</span>
                <h2>Let’s get you<br class="d-none d-lg-block" /> feeling better.</h2>
                <p>Get in touch to arrange your visit. Our team will be happy to help.</p>
                <a class="btn btn-light contact-cta" href="tel:<%= clinic.phoneLink %>">
                  <i class="bi bi-telephone me-2" aria-hidden="true"></i> Call the clinic
                </a>
              </div>
              <div class="col-lg-6 offset-lg-1">
                <div class="contact-detail">
                  <span class="detail-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                  <div><h3>Visit us</h3><p><%= clinic.address %></p></div>
                </div>
                <div class="contact-detail">
                  <span class="detail-icon"><i class="bi bi-telephone" aria-hidden="true"></i></span>
                  <div><h3>Call us</h3><p><a href="tel:<%= clinic.phoneLink %>"><%= clinic.phone %></a></p></div>
                </div>
                <div class="contact-detail">
                  <span class="detail-icon"><i class="bi bi-clock" aria-hidden="true"></i></span>
                  <div><h3>Opening hours</h3><p>Mon–Sat, 9am–9pm<br />Sunday: Closed</p></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

<%- include("partials/footer", { clinic }) %>
